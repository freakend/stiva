{
  "name": "stiva",
  "version": "1.0.0",
  "description": "Private browser collage maker. Stack and arrange photos in configurable grid layouts, crop with pan and zoom, export up to 3000px PNG. Everything stays in your browser.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "author": "Imbe (https://imbe.net)",
  "homepage": "https://stiva.imbe.net/",
  "repository": {
    "type": "git",
    "url": "https://github.com/freakend/stiva.git"
  },
  "bugs": {
    "url": "https://github.com/freakend/stiva/issues"
  },
  "keywords": [
    "collage",
    "collage-maker",
    "photo-collage",
    "photo-grid",
    "photo-stack",
    "image-collage",
    "png-export",
    "pwa",
    "vite",
    "react",
    "tailwindcss",
    "privacy"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.3",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
